---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const hasQrAction = config.links.some(item => item.qrImage);
---
<div class="card-base p-3">
    <a aria-label="Go to About Page" href={url("/about/")}
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-[12rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="px-2">
        <div class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{config.name}</div>
        <div class="h-1 w-5 bg-[var(--primary)] mx-auto rounded-full mb-2 transition"></div>
        <div class="text-center text-neutral-400 mb-2.5 transition">{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.map(item =>
                item.qrImage ? (
                    <button
                        type="button"
                        aria-label={`查看${item.name}二维码`}
                        title={`查看${item.name}二维码`}
                        data-profile-qr
                        data-qr-image={item.qrImage}
                        data-qr-alt={item.qrAlt || item.name}
                        class="btn-regular rounded-lg h-10 w-10 active:scale-90"
                    >
                        <Icon name={item.icon} class="text-[1.2rem]"></Icon>
                    </button>
                ) : (
                    <a rel="me" aria-label={item.name} title={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                        <Icon name={item.icon} class="text-[1.2rem]"></Icon>
                    </a>
                )
            )}
        </div>
    </div>
</div>

{hasQrAction && <div
    id="profile-qr-modal"
    class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/75 px-4 backdrop-blur-sm"
    aria-hidden="true"
>
    <button type="button" data-profile-qr-close class="absolute inset-0 cursor-default" aria-label="关闭二维码弹窗"></button>
    <div class="relative z-10 w-full max-w-[22rem]">
        <button
            type="button"
            data-profile-qr-close
            aria-label="关闭二维码弹窗"
            class="btn-regular absolute -right-2 -top-2 z-10 h-10 w-10 rounded-full active:scale-90"
        >
            <Icon name="fa6-solid:xmark" class="text-base"></Icon>
        </button>
        <div class="overflow-hidden rounded-[1.75rem] border border-white/10 bg-[var(--card-bg)] p-3 shadow-2xl">
            <img id="profile-qr-image" src="" alt="" class="block aspect-square w-full rounded-[1.25rem] object-cover">
        </div>
    </div>
</div>}

<script is:inline>
document.addEventListener("click", event => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const profileQrModal = document.getElementById("profile-qr-modal");
    const profileQrImage = document.getElementById("profile-qr-image");

    const qrButton = target.closest("[data-profile-qr]");
    if (qrButton instanceof HTMLButtonElement) {
        event.preventDefault();
        if (!profileQrModal || !(profileQrImage instanceof HTMLImageElement)) return;

        const qrImage = qrButton.getAttribute("data-qr-image");
        const qrAlt = qrButton.getAttribute("data-qr-alt") || "";
        if (!qrImage) return;

        profileQrImage.src = qrImage;
        profileQrImage.alt = qrAlt;
        profileQrModal.classList.remove("hidden");
        profileQrModal.classList.add("flex");
        profileQrModal.setAttribute("aria-hidden", "false");
        document.body.classList.add("overflow-hidden");
        return;
    }

    const closeButton = target.closest("[data-profile-qr-close]");
    if (closeButton && profileQrModal) {
        event.preventDefault();
        profileQrModal.classList.add("hidden");
        profileQrModal.classList.remove("flex");
        profileQrModal.setAttribute("aria-hidden", "true");
        document.body.classList.remove("overflow-hidden");
    }
});

document.addEventListener("keydown", event => {
    if (event.key !== "Escape") return;

    const profileQrModal = document.getElementById("profile-qr-modal");
    if (!profileQrModal) return;

    profileQrModal.classList.add("hidden");
    profileQrModal.classList.remove("flex");
    profileQrModal.setAttribute("aria-hidden", "true");
    document.body.classList.remove("overflow-hidden");
});
</script>
